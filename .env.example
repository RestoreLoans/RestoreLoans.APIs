# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/restoreloanDB

# SMTP (mail.restoreloans.co.za:587 = STARTTLS, 465 = implicit TLS)
SMTP_SERVER=mail.restoreloans.co.za
SMTP_PORT=587
SENDER_EMAIL=noreply@restoreloans.co.za
SENDER_PASSWORD=your_smtp_password_here

# Failover SMTP that owns the applicants@ mailbox. Required on hosts that
# block the primary account; the "New Loan Application" email uses it.
FALLBACK_SMTP_SERVER=mail.restoreloans.co.za
FALLBACK_SMTP_PORT=587
FALLBACK_SMTP_USERNAME=applicants@restoreloans.co.za
FALLBACK_SMTP_PASSWORD=your_applicants_password_here
FALLBACK_SENDER_EMAIL=applicants@restoreloans.co.za
FALLBACK_SENDER_NAME=RestoreLoans
FALLBACK_MAIL_FROM=applicants@restoreloans.co.za

# Google Cloud Storage. Either place the service-account file at
# app/utils/google.json or paste its contents (single line) into this variable
# on hosts where you cannot upload files.
# GOOGLE_APPLICATION_CREDENTIALS=app/utils/google.json
# GOOGLE_CREDENTIALS_JSON={"type":"service_account", ...}
